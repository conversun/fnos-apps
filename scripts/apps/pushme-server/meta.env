FILE_PREFIX=pushme-server
RELEASE_TITLE="PushMe Server"
DEFAULT_PORT=0
HOMEPAGE_URL="https://github.com/yafoo/pushme-server"
CATEGORY=system
# Official-fpk passthrough. The release tag (v3.x) diverges from the fpk's
# internal manifest version (what the daemon registers), so VERSION tracks the
# internal version and the download tag pins the raw ${UPSTREAM_TAG}.
OFFICIAL_FPK_REPO='yafoo/pushme-server'
OFFICIAL_FPK_TAG_TEMPLATE='${UPSTREAM_TAG}'
OFFICIAL_FPK_ASSET_x86='pushme-server.fpk'
OFFICIAL_FPK_ASSET_arm='pushme-server.fpk'
