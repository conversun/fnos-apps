FILE_PREFIX=clash-for-fnos
RELEASE_TITLE="Clash for fnos"
DEFAULT_PORT=0
HOMEPAGE_URL="https://github.com/chenpingonline/Clash-for-fnos"
CATEGORY=network
# Official-fpk passthrough: the upstream ships its own fnOS packages (desktop
# micro-app, root helper). The workflow downloads these directly; asset
# templates expand ${VERSION} at build time.
OFFICIAL_FPK_REPO='chenpingonline/Clash-for-fnos'
OFFICIAL_FPK_TAG_PREFIX='v'
OFFICIAL_FPK_ASSET_x86='Clash.for.fnos_${VERSION}_x86_64.fpk'
OFFICIAL_FPK_ASSET_arm='Clash.for.fnos_${VERSION}_arm64.fpk'
