FILE_PREFIX=Aellus
RELEASE_TITLE="Aellus"
DEFAULT_PORT=5115
HOMEPAGE_URL="https://github.com/YGQ8988/Aellus"
CATEGORY=network
# Official-fpk passthrough: the upstream ships its own fnOS packages and
# keeps them current (gateway socket, api-scope, micro-app). The workflow
# downloads these instead of running build.sh; asset templates expand
# ${VERSION} at build time.
OFFICIAL_FPK_REPO='YGQ8988/Aellus'
OFFICIAL_FPK_ASSET_x86='Aellus-${VERSION}-fnos-x64.fpk'
OFFICIAL_FPK_ASSET_arm='Aellus-${VERSION}-fnos-arm64.fpk'
