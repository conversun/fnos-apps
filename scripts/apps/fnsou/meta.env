FILE_PREFIX=fnsou
RELEASE_TITLE="飞牛Everything"
DEFAULT_PORT=8765
HOMEPAGE_URL="https://github.com/lilcandi/fnnas"
CATEGORY=system
# Official-fpk passthrough. 上游自己出 fnOS 包，本仓库不重打包，直接发布上游
# Release 里的 fpk（字节一致）。上游 tag 形如 v1.6.1，资产名 fnsou.v1.6.1.x86_64.fpk。
SUPPORTED_ARCH="x86 arm"
OFFICIAL_FPK_REPO='lilcandi/fnnas'
OFFICIAL_FPK_TAG_PREFIX='v'
OFFICIAL_FPK_ASSET_x86='fnsou.v${VERSION}.x86_64.fpk'
OFFICIAL_FPK_ASSET_arm='fnsou.v${VERSION}.arm.fpk'
