FILE_PREFIX=LitePan
RELEASE_TITLE="LitePan"
DEFAULT_PORT=0
HOMEPAGE_URL="https://github.com/qilin-zhu/LitePan-fpk"
CATEGORY=content
# Official-fpk passthrough. Upstream tags carry a -fpk-N rev suffix while the
# fpk filename uses the bare base version, so VERSION is the base version and
# the download tag pins the raw ${UPSTREAM_TAG}.
OFFICIAL_FPK_REPO='qilin-zhu/LitePan-fpk'
OFFICIAL_FPK_TAG_TEMPLATE='${UPSTREAM_TAG}'
OFFICIAL_FPK_ASSET_x86='LitePan_x86_${VERSION}.fpk'
OFFICIAL_FPK_ASSET_arm='LitePan_arm_${VERSION}.fpk'
