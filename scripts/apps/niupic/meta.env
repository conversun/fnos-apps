FILE_PREFIX=niupic
RELEASE_TITLE="NiuPic"
DEFAULT_PORT=0
HOMEPAGE_URL="https://github.com/LiuFudi/NiuPic"
CATEGORY=content
# Official-fpk passthrough. Upstream tags use a capital V prefix and publish
# x86-only packages.
SUPPORTED_ARCH="x86"
OFFICIAL_FPK_REPO='LiuFudi/NiuPic'
OFFICIAL_FPK_TAG_PREFIX='V'
OFFICIAL_FPK_ASSET_x86='niupic_${VERSION}_x86.fpk'
OFFICIAL_FPK_ASSET_arm='niupic_${VERSION}_arm.fpk'
