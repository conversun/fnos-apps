FILE_PREFIX=menote
RELEASE_TITLE="MeNote"
DEFAULT_PORT=3107
HOMEPAGE_URL="https://github.com/yafoo/menote"
CATEGORY=content
# Official-fpk passthrough; versionless asset, universal fpk (platform=all).
# Tag diverges from the fpk's internal version (v2.x vs 1.0.0) — same shape
# as pushme-server: VERSION tracks the internal fpk version, the download
# tag pins the raw ${UPSTREAM_TAG}.
OFFICIAL_FPK_REPO='yafoo/menote'
OFFICIAL_FPK_TAG_TEMPLATE='${UPSTREAM_TAG}'
OFFICIAL_FPK_ASSET_x86='menote.fpk'
OFFICIAL_FPK_ASSET_arm='menote.fpk'
