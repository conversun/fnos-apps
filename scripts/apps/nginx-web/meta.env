FILE_PREFIX=nginx-web
RELEASE_TITLE="nginx-web"
DEFAULT_PORT=0
HOMEPAGE_URL="https://github.com/chenpingonline/nginx-web-fnos"
CATEGORY=network
# Official-fpk passthrough (standard variant; full-ports 见上游 Release).
OFFICIAL_FPK_REPO='chenpingonline/nginx-web-fnos'
OFFICIAL_FPK_TAG_PREFIX='v'
OFFICIAL_FPK_ASSET_x86='nginx-web-${VERSION}-standard-x86_64.fpk'
OFFICIAL_FPK_ASSET_arm='nginx-web-${VERSION}-standard-arm64.fpk'
