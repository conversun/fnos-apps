FILE_PREFIX=fntvplus
RELEASE_TITLE="Fntv-Plus"
DEFAULT_PORT=22350
HOMEPAGE_URL="https://github.com/YDMY007/Fntv-Plus-fpk"
CATEGORY=media
AUTO_UPDATE_DISABLED_REASON="上游 YDMY007/Fntv-Plus-fpk 仓库及 releases 返回 404，等待恢复或确认迁移地址；仍可手动触发构建"
# Official-fpk passthrough. Upstream tags AND asset names use a capital V
# prefix (V1.0.1.224 / Fntv-Plus-V1.0.1.224.fpk); upstream is x86-only.
SUPPORTED_ARCH="x86"
OFFICIAL_FPK_REPO='YDMY007/Fntv-Plus-fpk'
OFFICIAL_FPK_TAG_PREFIX='V'
OFFICIAL_FPK_ASSET_x86='Fntv-Plus-V${VERSION}.fpk'
OFFICIAL_FPK_ASSET_arm='Fntv-Plus-V${VERSION}.fpk'
