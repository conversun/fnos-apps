#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

SERVICE_COMMAND="$APP_DIR/bin/homebox-server $APP_DATA_DIR"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

service_postinst() {
    mkdir -p "${TRIM_PKGVAR}/.data" 2>/dev/null || true
    # 0.26+ refuses to start without a >=32-byte API-key pepper; generate
    # once and persist (rotating it invalidates issued API keys).
    local pepper_file="${TRIM_PKGVAR}/.api_key_pepper"
    if [ ! -s "$pepper_file" ]; then
        head -c 48 /dev/urandom | base64 | tr -d '\n' | head -c 64 > "$pepper_file"
        chmod 600 "$pepper_file" 2>/dev/null || true
    fi
}

service_poststop() {
    pkill -f "^${APP_DIR}/homebox" 2>/dev/null || true  # pkill-f-ok: anchored to the absolute install path
}
