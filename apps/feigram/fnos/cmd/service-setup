#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${TRIM_PKGETC}/feigram.env"

# The shared framework tracks and stops one PID per command.
SERVICE_COMMAND="$APP_DIR/bin/feigram-server $APP_DATA_DIR
$APP_DIR/bin/feigram-downloader"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
SVC_WAIT_TIMEOUT=30

write_feigram_config() {
    mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/data/downloads" 2>/dev/null || true
    {
        printf 'APP_PORT=%s\n' "${wizard_app_port:-${TRIM_SERVICE_PORT:-3088}}"
        printf 'PUBLIC_BASE_URL=%s\n' "${wizard_public_base_url:-http://127.0.0.1:${TRIM_SERVICE_PORT:-3088}}"
        printf 'APP_PASSWORD=%s\n' "${wizard_app_password:-}"
        printf 'TELEGRAM_API_ID=%s\n' "${wizard_telegram_api_id:-}"
        printf 'TELEGRAM_API_HASH=%s\n' "${wizard_telegram_api_hash:-}"
    } > "${CONFIG_FILE}"
    chmod 600 "${CONFIG_FILE}" 2>/dev/null || true
}

load_feigram_config() {
    [ -f "${CONFIG_FILE}" ] || write_feigram_config
    while IFS='=' read -r key value; do
        case "$key" in
            APP_PORT|PUBLIC_BASE_URL|APP_PASSWORD|TELEGRAM_API_ID|TELEGRAM_API_HASH)
                export "$key=$value"
                ;;
        esac
    done < "${CONFIG_FILE}"
}

service_postinst() {
    write_feigram_config
}

service_postconfig() {
    write_feigram_config
}

service_prestart() {
    service_poststop
    load_feigram_config
    export DATA_DIR="${APP_DATA_DIR}/data"
    export DOWNLOAD_DIR="${DATA_DIR}/downloads"
    export FEIGRAM_DOWNLOADER_PORT=3090
    export FEIGRAM_DOWNLOADER_URL="http://127.0.0.1:${FEIGRAM_DOWNLOADER_PORT}"
    export FEIGRAM_DOWNLOADER_DATA="${DATA_DIR}/downloader"
    # Node generates app-secret; Go must use the same key for native sessions.
    export FEIGRAM_DOWNLOADER_SECRET_FILE="${DATA_DIR}/app-secret"
    mkdir -p "${DOWNLOAD_DIR}" "${FEIGRAM_DOWNLOADER_DATA}"
}

service_preuninst() {
    if [ -f "${PID_FILE}" ]; then
        while read -r pid; do
            [ -n "$pid" ] || continue
            kill "$pid" 2>/dev/null || true
        done < "${PID_FILE}"
        sleep 1
        while read -r pid; do
            [ -n "$pid" ] || continue
            kill -9 "$pid" 2>/dev/null || true
        done < "${PID_FILE}"
        rm -f "${PID_FILE}"
    fi
}

service_poststop() {
    # A failed status check can discard the shared PID file; reap survivors too.
    local pid
    for pid in $(pgrep -f "^${APP_DIR}/bin/(node src/index\\.js|feigram-downloader)$"); do
        kill -TERM "$pid" 2>/dev/null || true
        wait_for_status 1 "${SVC_WAIT_TIMEOUT}" "$pid" || kill -KILL "$pid" 2>/dev/null || true
    done
    rm -f "${PID_FILE}"
}
